---
/* The BICF logo (2026): a navy upright and a bright blue crossbar that
   divide B, I, C and F into quarters. Drawn as plain SVG shapes (letters
   traced from Montserrat), so it looks the same everywhere and loads no font.

   variant: 'mark' (default) is the cross and letters on their own.
            'horizontal' adds a rule and the four-line name to the right.
            'stacked' puts the name underneath.

   Colours come from CSS custom properties so each design can tint it:
     --logo-ink    letters and name   (default navy #182a42)
     --logo-cross  the upright        (default navy #182a42)
     --logo-bar    the crossbar and "INTERNATIONAL" (default blue #018cdd)
   On a dark background, set --logo-ink and --logo-cross to white. */
interface Props { class?: string; title?: string; variant?: 'mark' | 'horizontal' | 'stacked' }
const { class: cls, title = 'Brno International Christian Fellowship', variant = 'mark' } = Astro.props;
