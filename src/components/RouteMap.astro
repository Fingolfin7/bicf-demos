---
/* A simple walking map from the Haškova stop to the Maják Center,
   traced from the route BICF has shared with visitors. Each design tints
   it with CSS custom properties:
   --map-bg, --map-block, --map-road, --map-route, --map-ink, --map-accent, --map-font */
interface Props { class?: string }
const { class: cls } = Astro.props;
---
<figure class:list={['route-map', cls]}>
  <svg viewBox="0 0 420 520" role="img" aria-labelledby="route-map-title route-map-desc">
    <title id="route-map-title">Walking route to the Maják Center</title>
    <desc id="route-map-desc">From the Haškova stop, walk north up Majdalenky past the BILLA supermarket and the Infinit wellness centre to Dusíkova. Maják is the yellow building on the left at Dusíkova 5. The walk takes about five minutes.</desc>
    <rect width="420" height="520" fill="var(--map-bg, #f3f1ec)" />

    <!-- buildings along the way -->
    <g fill="var(--map-block, #e2ded5)">
      <rect x="32" y="120" width="104" height="58" rx="4" />
      <rect x="32" y="196" width="104" height="96" rx="4" />
      <rect x="32" y="312" width="104" height="70" rx="4" />
      <rect x="226" y="120" width="76" height="66" rx="4" />
      <rect x="318" y="120" width="80" height="120" rx="4" />
      <rect x="226" y="214" width="76" height="70" rx="4" />
      <rect x="226" y="330" width="120" height="72" rx="4" />
      <rect x="128" y="20" width="76" height="46" rx="4" />
    </g>

    <!-- streets -->
    <g fill="none" stroke="var(--map-road, #ffffff)" stroke-linecap="round">
      <path d="M10 470 L410 440" stroke-width="26" />
      <path d="M60 96 L410 96" stroke-width="18" />
      <path d="M190 458 L190 96" stroke-width="12" />
    </g>
    <g font-family="var(--map-font, system-ui, sans-serif)" font-size="12" fill="var(--map-ink, #222)" opacity="0.75">
      <text x="300" y="472" transform="rotate(-4.3 300 472)">Okružní</text>
      <text x="300" y="88">Dusíkova</text>
      <text x="0" y="0" transform="translate(170 300) rotate(90)">Majdalenky</text>
    </g>

    <!-- landmarks -->
    <g font-family="var(--map-font, system-ui, sans-serif)" font-size="12.5" font-weight="600" fill="var(--map-ink, #222)">
      <text x="286" y="372" text-anchor="middle">BILLA</text>
      <text x="264" y="245" text-anchor="middle">Infinit</text>
      <text x="264" y="260" text-anchor="middle" font-weight="400" font-size="11">wellness</text>
      <g transform="translate(150 140)">
        <rect x="-11" y="-11" width="22" height="22" rx="5" fill="var(--map-ink, #222)" />
        <text y="5" text-anchor="middle" fill="var(--map-bg, #f3f1ec)" font-size="14" font-weight="700">P</text>
      </g>
    </g>

    <!-- the walk -->
    <path class="route-map__walk" d="M190 452 L190 96 L166 96 L166 66" fill="none" stroke="var(--map-route, #54699f)" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="2 12" />

    <!-- start: the stop -->
    <g transform="translate(190 452)">
      <circle r="13" fill="var(--map-bg, #f3f1ec)" stroke="var(--map-route, #54699f)" stroke-width="4" />
      <circle r="5" fill="var(--map-route, #54699f)" />
    </g>
    <text x="172" y="500" text-anchor="end" font-family="var(--map-font, system-ui, sans-serif)" font-size="13" font-weight="700" fill="var(--map-ink, #222)">Haškova stop</text>

    <!-- end: Maják -->
    <g transform="translate(166 43)">
      <rect x="-30" y="-22" width="60" height="44" rx="8" fill="var(--map-accent, #54699f)" />
      <rect x="-2.5" y="-15" width="5" height="30" fill="#fff" />
      <rect x="-14" y="-6" width="28" height="4.5" fill="#fff" />
    </g>
    <text x="210" y="40" font-family="var(--map-font, system-ui, sans-serif)" font-size="15" font-weight="800" fill="var(--map-ink, #222)">Maják Center</text>
    <text x="210" y="57" font-family="var(--map-font, system-ui, sans-serif)" font-size="12" fill="var(--map-ink, #222)" opacity="0.8">Dusíkova 5</text>

    <!-- north -->
    <g transform="translate(380 500)" font-family="var(--map-font, system-ui, sans-serif)" fill="var(--map-ink, #222)">
      <path d="M0 -26 L7 -8 L0 -12 L-7 -8 Z" />
      <text y="6" text-anchor="middle" font-size="11" font-weight="700">N</text>
    </g>
  </svg>
  <figcaption>About a five-minute walk. Not to scale.</figcaption>
</figure>
<style>
  .route-map { margin: 0; }
  .route-map svg { display: block; width: 100%; height: auto; border-radius: inherit; }
  .route-map figcaption { font-size: 0.85rem; opacity: 0.75; margin-top: 8px; }
  @media (prefers-reduced-motion: no-preference) {
    .route-map__walk { animation: route-march 1.4s linear infinite; }
    @keyframes route-march { to { stroke-dashoffset: -28; } }
  }
</style>
