---
/* Floating control for the committee to jump between the demos.
   Not part of any design: delete this component when one is chosen. */
import { THEMES } from '../lib/themes';
import { BASE, withBase } from '../lib/base';
interface Props { current: string }
const { current } = Astro.props;
const path = Astro.url.pathname.slice(BASE.length).replace(/^\/[^/]+/, '');
---
<details class="demo-switch">
  <summary>Design: {THEMES.find((t) => t.id === current)?.name}</summary>
  <div class="demo-switch__menu">
    <p>Same content, four designs. Switch to see this page in another.</p>
    <ul>
      {THEMES.map((t) => (
        <li><a href={withBase(`/${t.id}${path}`)} aria-current={t.id === current ? 'page' : undefined}>{t.name}</a></li>
      ))}
      <li><a href={withBase('/')}>All demos</a></li>
      <li><a href={withBase('/admin/index.html')}>Open the CMS</a></li>
    </ul>
  </div>
</details>
<style>
  .demo-switch {
    position: fixed; left: 12px; bottom: 12px; z-index: 9999;
    font: 500 13px/1.3 system-ui, -apple-system, 'Segoe UI', sans-serif;
    color: #fff; background: rgb(20 20 28 / .86); backdrop-filter: blur(8px);
    border-radius: 12px; box-shadow: 0 6px 24px rgb(0 0 0 / .25); max-width: calc(100vw - 24px);
  }
  .demo-switch summary { cursor: pointer; padding: 9px 14px; list-style: none; user-select: none; }
  .demo-switch summary::-webkit-details-marker { display: none; }
  .demo-switch summary::before { content: ''; display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: #7CF29A; margin-right: 8px; vertical-align: 1px; }
  .demo-switch__menu { padding: 0 14px 12px; width: 230px; }
  .demo-switch p { margin: 0 0 8px; opacity: .7; font-weight: 400; }
  .demo-switch ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
  .demo-switch a { color: inherit; text-decoration: none; display: block; padding: 6px 8px; border-radius: 6px; }
  .demo-switch a:hover, .demo-switch a:focus-visible { background: rgb(255 255 255 / .12); }
  .demo-switch a[aria-current] { background: rgb(255 255 255 / .2); }
  .demo-switch li:nth-last-child(2) { border-top: 1px solid rgb(255 255 255 / .15); margin-top: 4px; padding-top: 4px; }
  .demo-switch :focus-visible { outline: 2px solid #7CF29A; outline-offset: 2px; }
  @media print { .demo-switch { display: none; } }
</style>
