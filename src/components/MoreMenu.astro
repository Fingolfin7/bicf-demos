---
/**
 * The "More" drop-down at the end of every design's top bar. It lists the
 * pages an editor has switched on with "Show in the top bar under More",
 * and hides itself when there are none. Render it as the last <li> of the
 * nav list. Each design tints it with these optional variables:
 *   --more-bg, --more-ink, --more-hover, --more-border, --more-radius,
 *   --more-shadow, --more-gap (space between the bar and the panel)
 * Its open/close behaviour is in more-menu.ts, loaded from BaseHead, because
 * a <script> here would be placed inside the nav list.
 */
import type { CollectionEntry } from 'astro:content';
import { link } from '../lib/themes';

interface Props { pages: CollectionEntry<'pages'>[]; theme: string; label?: string }
const { pages, theme, label = 'More' } = Astro.props;
const path = Astro.url.pathname;
const items = pages.map((p) => ({ href: link(theme, p.id), title: p.data.title }));
const here = items.some((i) => i.href === path);
---
{items.length > 0 && (
  <li class="more">
    <details class="more__details" data-more>
      <summary data-current={here ? '' : undefined}>
        {label}
        <svg class="more__chev" viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5" /></svg>
      </summary>
      <ul class="more__list" role="list">
        {items.map((i) => <li><a href={i.href} aria-current={i.href === path ? 'page' : undefined}>{i.title}</a></li>)}
      </ul>
    </details>
  </li>
)}

<style>
  .more { position: relative; }
  .more__details > summary { display: flex; align-items: center; gap: 0.35em; list-style: none; cursor: pointer; user-select: none; }
  .more__details > summary::-webkit-details-marker { display: none; }
  .more__chev { width: 0.8em; height: 0.8em; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; transition: transform 0.2s; }
  .more__details[open] .more__chev { transform: rotate(180deg); }
  .more__list {
    position: absolute; right: 0; top: calc(100% + var(--more-gap, 10px)); z-index: 60;
    display: grid; gap: 2px; min-width: 230px; margin: 0; padding: 8px; list-style: none;
    background: var(--more-bg, #fff); color: var(--more-ink, #1b1b1b);
    border: var(--more-border, 1px solid rgb(0 0 0 / 0.08)); border-radius: var(--more-radius, 14px);
    box-shadow: var(--more-shadow, 0 18px 44px rgb(0 0 0 / 0.16));
    font-size: 0.95rem; font-weight: 500; letter-spacing: normal; text-transform: none; line-height: 1.3;
  }
  .more__list a {
    display: block; padding: 10px 12px; border-radius: calc(var(--more-radius, 14px) - 6px);
    color: inherit; text-decoration: none; white-space: nowrap; background: none;
  }
  .more__list a:hover, .more__list a:focus-visible { background: var(--more-hover, rgb(0 0 0 / 0.06)); }
  .more__list a[aria-current] { font-weight: 700; }
  @media (prefers-reduced-motion: reduce) { .more__chev { transition: none; } }
</style>

