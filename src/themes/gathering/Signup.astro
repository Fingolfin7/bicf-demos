---
import Layout from './Layout.astro';
import PageHead from './PageHead.astro';
import SignupEngine from '../../components/SignupEngine.astro';
import { formatDate } from '../../lib/data';
import { link } from '../../lib/themes';
const { signup } = Astro.props;
const d = signup.data;
const L = (p = '') => link('gathering', p);
---
<Layout title={d.title} description={d.intro} image={d.image}>
  <PageHead title={d.title} lead={d.intro} image={d.image} crumb={{ href: L('week'), label: 'During the week' }}>
    <p class="g-date">{formatDate(d.date, 'weekday')}</p>
  </PageHead>
  <div class="g-page-body g-page-body--single" style="grid-template-columns: minmax(0, 60rem)">
    <SignupEngine id={signup.id} slots={d.slots} closes={d.closes} privacyHref={L('privacy')} />
  </div>
</Layout>
