---
import Layout from './Layout.astro';
import PageHead from './PageHead.astro';
import FormEngine from '../../components/FormEngine.astro';
import { getSettings, getForm, getNavPages, getSectionOf, render, friendlyTime } from '../../lib/data';
import { link } from '../../lib/themes';
import { img } from '../../lib/img';
const { page } = Astro.props;
const { Content } = await render(page);
const form = await getForm(page.data.form);
const s = await getSettings();
const section = await getSectionOf(page.id);
const siblings = section ? await getNavPages(section) : [];
const L = (p = '') => link('gathering', p);
---
<Layout title={page.data.title} description={page.data.summary} image={page.data.image}>
  <PageHead title={page.data.title} lead={page.data.summary} />
  <div class="g-page-body">
    <div>
      <div class="g-prose"><Content /></div>
      {form && <div class="g-formwrap"><FormEngine form={form} privacyHref={L('privacy')} /></div>}
    </div>
    <aside class="g-page-side">
      {page.data.image && <img {...img(page.data.image, '(max-width: 860px) 100vw, 45vw')} alt="" loading="lazy" />}
      {!form && (
        <div class="g-panel">
          <p class="g-eyebrow">Join us</p>
          <p class="g-panel-big">{s.serviceDay}s at {friendlyTime(s.serviceTime)}</p>
          <p>{s.venue}, {s.address}</p>
          <a class="g-btn g-btn--small" href={L('visit')}>Plan a visit</a>
        </div>
      )}
      {siblings.length > 1 && (
        <nav class="g-panel" aria-label="In this section">
          <p class="g-eyebrow">{section === 'join-in' ? 'Join in' : 'Who we are'}</p>
          <ul>
            {siblings.map((p) => <li><a href={L(p.id)} aria-current={p.id === page.id ? 'page' : undefined}>{p.data.title}</a></li>)}
          </ul>
        </nav>
      )}
    </aside>
  </div>
</Layout>
