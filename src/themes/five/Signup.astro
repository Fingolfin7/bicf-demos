---
import Layout from './Layout.astro';
import PageHero from './PageHero.astro';
import SignupEngine from '../../components/SignupEngine.astro';
import { formatDate } from '../../lib/data';
import { link } from '../../lib/themes';
const { signup } = Astro.props;
const d = signup.data;
const L = (p = '') => link('five', p);
---
<Layout title={d.title} description={d.intro} image={d.image}>
  <PageHero title={d.title} lead={d.intro} image={d.image} crumb={{ href: L('week'), label: 'This week' }}>
    <p class="d-pagehero__date">{formatDate(d.date, 'weekday')}</p>
  </PageHero>
  <section class="d-section d-section--body">
    <div class="d-wrap d-wrap--narrow">
      <SignupEngine id={signup.id} slots={d.slots} closes={d.closes} privacyHref={L('privacy')} />
    </div>
  </section>
</Layout>
