---
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource-variable/manrope';
import './five.css';
import BaseHead from '../../components/BaseHead.astro';
import DemoSwitcher from '../../components/DemoSwitcher.astro';
import Logo from '../../components/Logo.astro';
import MoreMenu from '../../components/MoreMenu.astro';
import { getSettings, getNavPages, friendlyTime, getMorePages } from '../../lib/data';
import { link } from '../../lib/themes';

interface Props { title?: string; description?: string; image?: string }
const s = await getSettings();
const { title, description = s.intro, image } = Astro.props;
const joinIn = await getNavPages('join-in');
const whoWeAre = await getNavPages('who-we-are');
const more = await getMorePages();
const L = (p = '') => link('five', p);
const path = Astro.url.pathname;
const nav = [
  { href: L('visit'), label: 'Sundays' },
  { href: L('week'), label: 'This week' },
  { href: L('thoughts'), label: 'Thoughts' },
  { href: L('prayer-box'), label: 'Prayer box' },
];
// On phones the top bar folds into the menu. Add the More pages it doesn't already list.
const moreExtra = more.filter((p) => p.data.section === 'none' && !nav.some((n) => n.href === L(p.id)) && p.id !== 'contact');
---
<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title ? `${title} | ${s.shortName}` : `${s.name} | Sunday at five`} description={description} themeColor="#0e0a19" image={image} />
  </head>
  <body>
    <a class="d-skip" href="#main">Skip to content</a>
    <header class="d-header">
      <a class="d-brand" href={L()} aria-label={`${s.name}, home`}>
        <Logo class="d-brand__mark" variant="horizontal" />
      </a>
      <nav class="d-nav" aria-label="Main">
        <ul>
          {nav.map((n) => <li><a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a></li>)}
          <MoreMenu pages={more} theme="five" />
        </ul>
        <a class="d-btn d-btn--sun d-nav__cta" href={L('visit')}>Plan a visit</a>
      </nav>
      <button class="d-menu-btn" type="button" aria-expanded="false" aria-controls="d-menu">Menu</button>
    </header>

    <div class="d-menu" id="d-menu" hidden>
      <div class="d-menu__inner">
        <ul class="d-menu__main">
          <li><a href={L()}>Home</a></li>
          {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        {moreExtra.map((p) => <li><a href={L(p.id)}>{p.data.title}</a></li>)}
          <li><a href={L('contact')}>Contact</a></li>
        </ul>
        <div class="d-menu__cols">
          <div>
            <p class="d-menu__head">Join in</p>
            <ul>{joinIn.map((p) => <li><a href={L(p.id)}>{p.data.title}</a></li>)}</ul>
          </div>
          <div>
            <p class="d-menu__head">Who we are</p>
            <ul>{whoWeAre.map((p) => <li><a href={L(p.id)}>{p.data.title}</a></li>)}</ul>
          </div>
        </div>
        <p class="d-menu__foot">{s.serviceDay}s at {friendlyTime(s.serviceTime)}, {s.venue}, {s.area}</p>
      </div>
    </div>

    <main id="main">
      <slot />
    </main>

    <footer class="d-footer">
      <div class="d-footer__sign">
        <div><Logo />
        <p class="d-footer__big">Every {s.serviceDay} at {friendlyTime(s.serviceTime)}.</p></div>
        <p>{s.venue}, {s.address}<br /><a href={s.mapUrl} rel="noopener">Open in Mapy.cz</a></p>
      </div>
      <div class="d-footer__cols">
        <div>
          <p class="d-footer__head">Join in</p>
          <ul>{joinIn.map((p) => <li><a href={L(p.id)}>{p.data.title}</a></li>)}</ul>
        </div>
        <div>
          <p class="d-footer__head">Who we are</p>
          <ul>{whoWeAre.map((p) => <li><a href={L(p.id)}>{p.data.title}</a></li>)}</ul>
        </div>
        <div>
          <p class="d-footer__head">Get in touch</p>
          <ul>
            <li><a href={`mailto:${s.email}`}>{s.email}</a></li>
            <li><a href={L('contact')}>Contact form</a></li>
            <li><a href={L('prayer-box')}>Prayer box</a></li>
            <li><a href={s.facebook} rel="noopener">Facebook</a></li>
          </ul>
        </div>
      </div>
      <p class="d-footer__legal">
        © {new Date().getFullYear()} {s.name}. <a href={L('privacy')}>Privacy</a>. No cookies, no tracking. Photos by the BICF family.
      </p>
    </footer>
    <DemoSwitcher current="five" />

    <script>
      const btn = document.querySelector<HTMLButtonElement>('.d-menu-btn')!;
      const menu = document.getElementById('d-menu')!;
      const setOpen = (open: boolean) => {
        btn.setAttribute('aria-expanded', String(open));
        btn.textContent = open ? 'Close' : 'Menu';
        menu.hidden = !open;
        document.body.classList.toggle('d-locked', open);
        if (open) menu.querySelector('a')?.focus();
      };
      btn.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.hidden) { setOpen(false); btn.focus(); } });
    </script>
  </body>
</html>
