---
import Layout from './Layout.astro';
import PageHero from './PageHero.astro';
import FormEngine from '../../components/FormEngine.astro';
import { getSettings, getForm, getNavPages, getSectionOf, render, friendlyTime } from '../../lib/data';
import { link } from '../../lib/themes';
const { page } = Astro.props;
const { Content } = await render(page);
const form = await getForm(page.data.form);
const s = await getSettings();
const section = await getSectionOf(page.id);
const siblings = section ? await getNavPages(section) : [];
const L = (p = '') => link('five', p);
---
<Layout title={page.data.title} description={page.data.summary} image={page.data.image}>
  <PageHero title={page.data.title} lead={page.data.summary} image={page.data.image} />
  <section class="d-section d-section--body">
    <div class:list={['d-wrap', 'd-body', { 'd-body--single': !!form }]}>
      <div>
        <div class="d-prose"><Content /></div>
        {form && <div class="d-formwrap"><FormEngine form={form} privacyHref={L('privacy')} /></div>}
      </div>
      {!form && (
        <aside class="d-aside">
          <div class="d-card">
            <h2>Join us on {s.serviceDay}</h2>
            <p>{friendlyTime(s.serviceTime)} at the {s.venue}, {s.address}.</p>
            <a class="d-btn d-btn--sun d-btn--sm" href={L('visit')}>Plan a visit</a>
          </div>
          {siblings.length > 1 && (
            <nav class="d-card" aria-label="In this section">
              <h2>{section === 'join-in' ? 'Join in' : 'Who we are'}</h2>
              <ul>
                {siblings.map((p) => <li><a href={L(p.id)} aria-current={p.id === page.id ? 'page' : undefined}>{p.data.title}</a></li>)}
              </ul>
            </nav>
          )}
        </aside>
      )}
    </div>
  </section>
</Layout>
