---
import '@fontsource-variable/fraunces/full.css';
import '@fontsource-variable/fraunces/full-italic.css';
import '@fontsource-variable/figtree';
import './hall.css';
import BaseHead from '../../components/BaseHead.astro';
import DemoSwitcher from '../../components/DemoSwitcher.astro';
import Logo from '../../components/Logo.astro';
import StringLights from './StringLights.astro';
import { getSettings, getNavPages, friendlyTime } from '../../lib/data';
import { link } from '../../lib/themes';

interface Props { title?: string; description?: string; image?: string }
const s = await getSettings();
const { title, description = s.intro, image } = Astro.props;
const joinIn = await getNavPages('join-in');
const whoWeAre = await getNavPages('who-we-are');
const L = (p = '') => link('hall', p);
const path = Astro.url.pathname;
const nav = [
  { href: L('visit'), label: 'Visit' },
  { href: L('week'), label: 'This week' },
  { href: L('thoughts'), label: 'Going deeper' },
  { href: L('prayer-box'), label: 'Prayer' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title ? `${title} | ${s.shortName}` : `${s.name} | Come in`} description={description} themeColor="#f5ecdf" image={image} />
  </head>
  <body>
    <a class="h-skip" href="#main">Skip to content</a>
    <header class="h-header">
      <a class="h-brand" href={L()} aria-label={`${s.name}, home`}>
        <Logo class="h-brand__logo" />
        <span class="h-brand__name">Brno International<br />Christian Fellowship</span>
      </a>
      <nav class="h-nav" aria-label="Main">
        <ul>
          {nav.map((n) => <li><a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a></li>)}
        </ul>
      </nav>
      <a class="h-btn h-btn--small h-header__cta" href={L('visit')}>Plan a visit</a>
      <button class="h-menu-btn" type="button" aria-expanded="false" aria-controls="h-menu">Menu</button>
    </header>

    <div class="h-menu" id="h-menu" hidden>
      <ul class="h-menu__main">
        <li><a href={L()}>Home</a></li>
        {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        <li><a href={L('contact')}>Contact</a></li>
      </ul>
      <div class="h-menu__cols">
        <div>
          <p class="h-eyebrow">Join in</p>
          <ul>{joinIn.map((p) => <li><a href={L(p.id)}>{p.data.title}</a></li>)}</ul>
        </div>
        <div>
          <p class="h-eyebrow">Who we are</p>
          <ul>{whoWeAre.map((p) => <li><a href={L(p.id)}>{p.data.title}</a></li>)}</ul>
        </div>
      </div>
    </div>

    <main id="main">
      <slot />
    </main>

    <footer class="h-footer">
      <StringLights swags={5} class="h-footer__lights" />
      <div class="h-wrap h-footer__grid">
        <div class="h-footer__welcome">
          <Logo class="h-footer__logo" />
          <p class="h-footer__big">See you on {s.serviceDay} at {friendlyTime(s.serviceTime)}.</p>
          <p>{s.venue}, {s.address}<br /><a href={s.mapUrl} rel="noopener">Open in Mapy.cz</a></p>
        </div>
        <div>
          <p class="h-eyebrow">Join in</p>
          <ul>{joinIn.map((p) => <li><a href={L(p.id)}>{p.data.title}</a></li>)}</ul>
        </div>
        <div>
          <p class="h-eyebrow">Who we are</p>
          <ul>{whoWeAre.map((p) => <li><a href={L(p.id)}>{p.data.title}</a></li>)}</ul>
        </div>
        <div>
          <p class="h-eyebrow">Say hello</p>
          <ul>
            <li><a href={`mailto:${s.email}`}>{s.email}</a></li>
            <li><a href={L('contact')}>Contact form</a></li>
            <li><a href={L('prayer-box')}>Prayer box</a></li>
            <li><a href={s.facebook} rel="noopener">Facebook</a></li>
          </ul>
        </div>
      </div>
      <p class="h-wrap h-footer__legal">© {new Date().getFullYear()} {s.name}. <a href={L('privacy')}>Privacy</a>. No cookies, no tracking. Photos by the BICF family.</p>
    </footer>
    <DemoSwitcher current="hall" />

    <script>
      const btn = document.querySelector<HTMLButtonElement>('.h-menu-btn')!;
      const menu = document.getElementById('h-menu')!;
      const setOpen = (open: boolean) => {
        btn.setAttribute('aria-expanded', String(open));
        btn.textContent = open ? 'Close' : 'Menu';
        menu.hidden = !open;
        document.body.classList.toggle('h-locked', open);
      };
      btn.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.hidden) { setOpen(false); btn.focus(); } });
    </script>
  </body>
</html>
