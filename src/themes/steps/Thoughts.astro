---
import Layout from './Layout.astro';
import PageHead from './PageHead.astro';
import { getThoughts, formatDate } from '../../lib/data';
import { link } from '../../lib/themes';
import { img } from '../../lib/img';
const thoughts = await getThoughts();
const L = (p = '') => link('steps', p);
---
<Layout title="Going deeper" description="Short reflections from the BICF community.">
  <PageHead title="Going deeper" lead="Short reflections from people in our church, for the days between Sundays." />
  <section class="ns-wrap ns-section ns-section--flush">
    <ul class="ns-cards" role="list">
      {thoughts.map((t) => (
        <li>
          <a class="ns-card" href={L(`thoughts/${t.id}`)}>
            {t.data.image && <img {...img(t.data.image, '(max-width: 860px) 100vw, 33vw')} alt="" loading="lazy" />}
            <p class="ns-meta">{t.data.author} · {formatDate(t.data.date)}</p>
            <h2>{t.data.title}</h2>
            <p>{t.data.excerpt}</p>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Layout>
