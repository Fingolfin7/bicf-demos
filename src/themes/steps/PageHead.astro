---
import { img } from '../../lib/img';
interface Props { title: string; lead?: string; image?: string; crumb?: { href: string; label: string } }
const { title, lead, image, crumb } = Astro.props;
---
<header class:list={['ns-pagehead', { 'ns-pagehead--image': image }]}>
  <div class="ns-pagehead__text">
    {crumb && <a class="ns-crumb" href={crumb.href}>← {crumb.label}</a>}
    <h1>{title}</h1>
    {lead && <p class="ns-pagehead__lead">{lead}</p>}
    <slot />
  </div>
  {image && <img class="ns-pagehead__img" {...img(image, '(max-width: 860px) 100vw, 45vw')} alt="" />}
</header>
