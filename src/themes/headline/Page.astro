---
import Layout from './Layout.astro';
import PageHead from './PageHead.astro';
import FormEngine from '../../components/FormEngine.astro';
import { getSettings, getForm, getNavPages, render, friendlyTime } from '../../lib/data';
import { link } from '../../lib/themes';
import { img } from '../../lib/img';
const { page } = Astro.props;
const { Content } = await render(page);
const form = await getForm(page.data.form);
const s = await getSettings();
const siblings = page.data.section === 'none' ? [] : await getNavPages(page.data.section);
const L = (p = '') => link('headline', p);
---
<Layout title={page.data.title} description={page.data.summary} image={page.data.image}>
  <PageHead title={page.data.title} lead={page.data.summary} />
  <div class="hl-body">
    <div>
      <div class="hl-prose"><Content /></div>
      {form && <div class="hl-formbox"><FormEngine form={form} privacyHref={L('privacy')} /></div>}
    </div>
    <aside class="hl-side">
      {page.data.image && <img {...img(page.data.image, '(max-width: 860px) 100vw, 40vw')} alt="" loading="lazy" />}
      {!form && (
        <div class="hl-card hl-card--dark">
          <p class="hl-tracked">Join us</p>
          <p class="hl-card__big">{s.serviceDay}s at {friendlyTime(s.serviceTime)}</p>
          <p>{s.venue}, {s.address}</p>
          <a class="hl-btn hl-btn--white" href={L('visit')}>Plan a visit</a>
        </div>
      )}
      {siblings.length > 1 && (
        <nav class="hl-card" aria-label="In this section">
          <p class="hl-tracked">{page.data.section === 'join-in' ? 'Join in' : 'Who we are'}</p>
          <ul class="hl-sidenav">
            {siblings.map((p) => <li><a href={L(p.id)} aria-current={p.id === page.id ? 'page' : undefined}>{p.data.title}</a></li>)}
          </ul>
        </nav>
      )}
    </aside>
  </div>
</Layout>
