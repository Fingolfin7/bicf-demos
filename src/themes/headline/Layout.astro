---
/* Headline: modern and minimal. Black, white and the logo's blue, with
   very large uppercase headlines that mix a thin and a heavy weight.
   Made after the church shared transformchurch.us as a reference. */
import '@fontsource-variable/montserrat';
import './headline.css';
import BaseHead from '../../components/BaseHead.astro';
import DemoSwitcher from '../../components/DemoSwitcher.astro';
import Logo from '../../components/Logo.astro';
import MoreMenu from '../../components/MoreMenu.astro';
import { getSettings, getNavPages, friendlyTime, getMorePages } from '../../lib/data';
import { link } from '../../lib/themes';

interface Props { title?: string; description?: string; image?: string }
const s = await getSettings();
const { title, description = s.intro, image } = Astro.props;
const joinIn = await getNavPages('join-in');
const whoWeAre = await getNavPages('who-we-are');
const more = await getMorePages();
const L = (p = '') => link('headline', p);
const path = Astro.url.pathname;
const nav = [
  { href: L(), label: 'Home' },
  { href: L('visit'), label: 'Visit' },
  { href: L('week'), label: 'This week' },
  { href: L('kids-and-teens'), label: 'Kids & teens' },
  { href: L('what-we-believe'), label: 'Beliefs' },
  { href: L('thoughts'), label: 'Going deeper' },
  { href: L('prayer-box'), label: 'Prayer' },
];
// On phones the top bar folds into the menu. Add the More pages it doesn't already list.
const moreExtra = more.filter((p) => p.data.section === 'none' && !nav.some((n) => n.href === L(p.id)) && p.id !== 'contact');
---
<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title ? `${title} | ${s.shortName}` : `${s.name} | From near and far`} description={description} themeColor="#ffffff" image={image} />
  </head>
  <body class="hl">
    <a class="hl-skip" href="#main">Skip to content</a>
    <header class="hl-header">
      <a class="hl-brand" href={L()} aria-label={`${s.name}, home`}>
        <Logo variant="horizontal" />
      </a>
      <nav class="hl-nav" aria-label="Main">
        <ul>
          {nav.map((n) => <li><a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a></li>)}
          <MoreMenu pages={more} theme="headline" />
        </ul>
      </nav>
      <button class="hl-menu-btn" type="button" aria-expanded="false" aria-controls="hl-menu">
        <span class="hl-menu-btn__bars" aria-hidden="true"></span>Menu
      </button>
    </header>

    <div class="hl-menu" id="hl-menu" hidden>
      <ul class="hl-menu__main">
        {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        {moreExtra.map((p) => <li><a href={L(p.id)}>{p.data.title}</a></li>)}
        <li><a href={L('contact')}>Contact</a></li>
      </ul>
      <div class="hl-menu__cols">
        <div>
          <p class="hl-label">Join in</p>
          <ul>{joinIn.map((p) => <li><a href={L(p.id)}>{p.data.title}</a></li>)}</ul>
        </div>
        <div>
          <p class="hl-label">Who we are</p>
          <ul>{whoWeAre.map((p) => <li><a href={L(p.id)}>{p.data.title}</a></li>)}</ul>
        </div>
      </div>
    </div>

    <main id="main"><slot /></main>

    <footer class="hl-footer">
      <div class="hl-footer__top">
        <div class="hl-footer__brand">
          <Logo variant="horizontal" />
          <p class="hl-footer__when"><span>{s.serviceDay}s</span> <b>{friendlyTime(s.serviceTime)}</b></p>
          <p>{s.venue}, {s.address}<br /><a href={s.mapUrl} rel="noopener">Open in Mapy.cz</a></p>
        </div>
        <div>
          <p class="hl-label">Join in</p>
          <ul>{joinIn.map((p) => <li><a href={L(p.id)}>{p.data.title}</a></li>)}</ul>
        </div>
        <div>
          <p class="hl-label">Who we are</p>
          <ul>{whoWeAre.map((p) => <li><a href={L(p.id)}>{p.data.title}</a></li>)}</ul>
        </div>
        <div>
          <p class="hl-label">Say hello</p>
          <ul>
            <li><a href={`mailto:${s.email}`}>{s.email}</a></li>
            <li><a href={L('contact')}>Contact form</a></li>
            <li><a href={L('prayer-box')}>Prayer box</a></li>
            <li><a href={s.facebook} rel="noopener">Facebook</a></li>
          </ul>
        </div>
      </div>
      <p class="hl-footer__legal">© {new Date().getFullYear()} {s.name}. <a href={L('privacy')}>Privacy</a>. No cookies, no tracking.</p>
    </footer>
    <DemoSwitcher current="headline" />

    <script>
      // Full-screen menu on small screens.
      const btn = document.querySelector<HTMLButtonElement>('.hl-menu-btn');
      const menu = document.getElementById('hl-menu');
      if (btn && menu) {
        const set = (open: boolean) => {
          btn.setAttribute('aria-expanded', String(open));
          menu.hidden = !open;
          document.body.classList.toggle('hl-locked', open);
        };
        btn.addEventListener('click', () => set(menu.hidden));
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.hidden) { set(false); btn.focus(); } });
        menu.addEventListener('click', (e) => { if ((e.target as Element).closest('a')) set(false); });
      }
    </script>
  </body>
</html>
