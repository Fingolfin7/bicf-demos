---
import Layout from './Layout.astro';
import PageHead from './PageHead.astro';
import { render, formatDate } from '../../lib/data';
import { link } from '../../lib/themes';
import { img } from '../../lib/img';
const { thought } = Astro.props;
const { Content } = await render(thought);
const d = thought.data;
const L = (p = '') => link('headline', p);
---
<Layout title={d.title} description={d.excerpt} image={d.image}>
  <PageHead title={d.title} lead={d.excerpt} crumb={{ href: L('thoughts'), label: 'Going deeper' }}>
    <p class="hl-tracked">{formatDate(d.date)} · {d.author}</p>
  </PageHead>
  <div class="hl-body">
    <article class="hl-prose">
      {d.scripture && <blockquote>{d.scripture}</blockquote>}
      <Content />
    </article>
    {d.image && <aside class="hl-side"><img {...img(d.image, '(max-width: 860px) 100vw, 40vw')} alt="" loading="lazy" /></aside>}
  </div>
</Layout>
