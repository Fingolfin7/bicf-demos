---
import '@fontsource-variable/archivo/wdth.css';
import './crossroads.css';
import BaseHead from '../../components/BaseHead.astro';
import DemoSwitcher from '../../components/DemoSwitcher.astro';
import Logo from '../../components/Logo.astro';
import MoreMenu from '../../components/MoreMenu.astro';
import { getSettings, getNavPages, friendlyTime, getMorePages } from '../../lib/data';
import { link } from '../../lib/themes';

interface Props { title?: string; description?: string; image?: string }
const s = await getSettings();
const { title, description = s.intro, image } = Astro.props;
const joinIn = await getNavPages('join-in');
const whoWeAre = await getNavPages('who-we-are');
const more = await getMorePages();
const L = (p = '') => link('crossroads', p);
const path = Astro.url.pathname;
const nav = [
  { href: L('visit'), label: 'Visit' },
  { href: L('week'), label: 'This week' },
  { href: L('thoughts'), label: 'Going deeper' },
  { href: L('contact'), label: 'Contact' },
];
// On phones the top bar folds into the menu. Add the More pages it doesn't already list.
const moreExtra = more.filter((p) => p.data.section === 'none' && !nav.some((n) => n.href === L(p.id)));
---
<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title ? `${title} | ${s.shortName}` : `${s.name} | ${s.tagline}`} description={description} themeColor="#54699f" image={image} />
  </head>
  <body>
    <a class="x-skip" href="#main">Skip to content</a>
    <header class="x-header">
      <a class="x-brand" href={L()} aria-label={`${s.name}, home`}>
        <Logo class="x-brand__logo" variant="horizontal" />
      </a>
      <nav class="x-nav" aria-label="Main">
        <ul>
          {nav.map((n) => <li><a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a></li>)}
          <MoreMenu pages={more} theme="crossroads" />
        </ul>
      </nav>
      <a class="x-when" href={L('visit')}><span>{s.serviceDay}s</span> {s.serviceTime}</a>
      <button class="x-menu-btn" type="button" aria-expanded="false" aria-controls="x-menu"><span class="x-menu-btn__icon" aria-hidden="true"></span><span class="x-menu-btn__label">Menu</span></button>
    </header>

    <div class="x-menu" id="x-menu" hidden>
      <ul class="x-menu__main">
        <li><a href={L()}>Home</a></li>
        {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        {moreExtra.map((p) => <li><a href={L(p.id)}>{p.data.title}</a></li>)}
      </ul>
      <div class="x-menu__cols">
        <div>
          <p class="x-label">Join in</p>
          <ul>{joinIn.map((p) => <li><a href={L(p.id)}>{p.data.title}</a></li>)}</ul>
        </div>
        <div>
          <p class="x-label">Who we are</p>
          <ul>{whoWeAre.map((p) => <li><a href={L(p.id)}>{p.data.title}</a></li>)}</ul>
        </div>
      </div>
    </div>

    <main id="main">
      <slot />
    </main>

    <footer class="x-footer">
      <div class="x-footer__cross" aria-hidden="true"></div>
      <div class="x-footer__q x-footer__q--1">
        <Logo class="x-footer__logo" variant="horizontal" />
        <p class="x-footer__tag">{s.tagline}.</p>
      </div>
      <div class="x-footer__q x-footer__q--2">
        <p class="x-label">Every {s.serviceDay}</p>
        <p class="x-footer__big">{friendlyTime(s.serviceTime)}</p>
        <p>{s.venue}<br />{s.address}<br /><a href={s.mapUrl} rel="noopener">Open in Mapy.cz</a></p>
      </div>
      <div class="x-footer__q x-footer__q--3">
        <div>
          <p class="x-label">Join in</p>
          <ul>{joinIn.map((p) => <li><a href={L(p.id)}>{p.data.title}</a></li>)}</ul>
        </div>
        <div>
          <p class="x-label">Who we are</p>
          <ul>{whoWeAre.map((p) => <li><a href={L(p.id)}>{p.data.title}</a></li>)}</ul>
        </div>
      </div>
      <div class="x-footer__q x-footer__q--4">
        <p class="x-label">Get in touch</p>
        <ul>
          <li><a href={`mailto:${s.email}`}>{s.email}</a></li>
          <li><a href={L('contact')}>Contact form</a></li>
          <li><a href={L('prayer-box')}>Prayer box</a></li>
          <li><a href={s.facebook} rel="noopener">Facebook</a></li>
        </ul>
        <p class="x-footer__legal">© {new Date().getFullYear()} {s.shortName}. <a href={L('privacy')}>Privacy</a>. No cookies, no tracking.</p>
      </div>
    </footer>
    <DemoSwitcher current="crossroads" />

    <script>
      const btn = document.querySelector<HTMLButtonElement>('.x-menu-btn')!;
      const label = btn.querySelector<HTMLElement>('.x-menu-btn__label')!;
      const menu = document.getElementById('x-menu')!;
      const setOpen = (open: boolean) => {
        btn.setAttribute('aria-expanded', String(open));
        label.textContent = open ? 'Close' : 'Menu';
        menu.hidden = !open;
        document.body.classList.toggle('x-locked', open);
      };
      btn.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.hidden) { setOpen(false); btn.focus(); } });
    </script>
  </body>
</html>
