---
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import './stillwater.css';
import BaseHead from '../../components/BaseHead.astro';
import DemoSwitcher from '../../components/DemoSwitcher.astro';
import { getSettings, getNavPages, friendlyTime } from '../../lib/data';
import { link } from '../../lib/themes';

interface Props { title?: string; description?: string; image?: string }
const s = await getSettings();
const { title, description = s.intro, image } = Astro.props;
const joinIn = await getNavPages('join-in');
const whoWeAre = await getNavPages('who-we-are');
const L = (p = '') => link('stillwater', p);
const path = Astro.url.pathname;
const nav = [
  { href: L('visit'), label: 'Visit' },
  { href: L('week'), label: 'The week' },
  { href: L('thoughts'), label: 'Reflections' },
  { href: L('what-we-believe'), label: 'Beliefs' },
  { href: L('prayer-box'), label: 'Prayer' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title ? `${title} | ${s.shortName}` : `${s.name}`} description={description} themeColor="#eef0ea" image={image} />
  </head>
  <body>
    <a class="w-skip" href="#main">Skip to content</a>
    <header class="w-header">
      <a class="w-brand" href={L()} aria-label={`${s.name}, home`}>
        <span class="w-brand__mark" aria-hidden="true"></span>
        <span>Brno International<br />Christian Fellowship</span>
      </a>
      <nav class="w-nav" aria-label="Main">
        <ul>
          {nav.map((n) => <li><a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a></li>)}
        </ul>
      </nav>
      <button class="w-menu-btn" type="button" aria-expanded="false" aria-controls="w-menu">Menu</button>
    </header>
    <div class="w-menu" id="w-menu" hidden>
      <nav aria-label="Site">
        <ul class="w-menu__main">
          <li><a href={L()}>Home</a></li>
          {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
          <li><a href={L('contact')}>Contact</a></li>
        </ul>
        <div class="w-menu__cols">
          <ul>{joinIn.map((p) => <li><a href={L(p.id)}>{p.data.title}</a></li>)}</ul>
          <ul>{whoWeAre.map((p) => <li><a href={L(p.id)}>{p.data.title}</a></li>)}</ul>
        </div>
      </nav>
    </div>

    <main id="main"><slot /></main>

    <footer class="w-footer">
      <div class="w-wrap w-footer__grid">
        <div class="w-footer__visit">
          <p class="w-footer__lead">Sundays at {friendlyTime(s.serviceTime)}.</p>
          <p>{s.venue}<br />{s.address}<br />{s.area}</p>
          <p><a href={s.mapUrl} rel="noopener">Open in Mapy.cz</a></p>
        </div>
        <nav class="w-footer__nav" aria-label="Footer">
          <div>
            <p class="w-footer__head">Join in</p>
            <ul>{joinIn.map((p) => <li><a href={L(p.id)}>{p.data.title}</a></li>)}</ul>
          </div>
          <div>
            <p class="w-footer__head">Who we are</p>
            <ul>{whoWeAre.map((p) => <li><a href={L(p.id)}>{p.data.title}</a></li>)}</ul>
          </div>
          <div>
            <p class="w-footer__head">Write to us</p>
            <ul>
              <li><a href={`mailto:${s.email}`}>{s.email}</a></li>
              <li><a href={L('contact')}>Contact form</a></li>
              <li><a href={L('prayer-box')}>Prayer box</a></li>
              <li><a href={s.facebook} rel="noopener">Facebook</a></li>
            </ul>
          </div>
        </nav>
      </div>
      <div class="w-wrap w-colophon">
        <p>Set in Newsreader. Photographs of Brno from Wikimedia Commons (<a href="/credits/">credits</a>). This site uses no cookies and no tracking. <a href={L('privacy')}>Privacy</a>.</p>
        <p>© {new Date().getFullYear()} {s.name}</p>
      </div>
    </footer>
    <DemoSwitcher current="stillwater" />

    <script>
      const btn = document.querySelector<HTMLButtonElement>('.w-menu-btn')!;
      const menu = document.getElementById('w-menu')!;
      const setOpen = (open: boolean) => {
        btn.setAttribute('aria-expanded', String(open));
        btn.textContent = open ? 'Close' : 'Menu';
        menu.hidden = !open;
      };
      btn.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.hidden) { setOpen(false); btn.focus(); } });
    </script>
  </body>
</html>
