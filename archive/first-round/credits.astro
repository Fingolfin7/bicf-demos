---
/* Attribution for the placeholder photos (required by their licences). */
import '@fontsource-variable/manrope';
import credits from '../data/credits.json';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Photo credits | BICF demos</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <main>
      <p><a href="/">All demos</a></p>
      <h1>Photo credits</h1>
      <p class="lead">The demos use openly licensed photographs from Wikimedia Commons as placeholders. Each one is listed here with its author and licence, as the licences require.</p>
      <ul>
        {credits.map((c) => (
          <li>
            <img src={`/media/stock/${c.file.replace('.webp', '-sm.webp')}`} alt="" loading="lazy" width="120" height="80" />
            <div>
              <a href={c.source} rel="noopener">{c.title}</a>
              <p>{c.author || 'Unknown author'}, {c.license}</p>
            </div>
          </li>
        ))}
      </ul>
    </main>
    <style>
      body { margin: 0; background: #f4f5f7; color: #16181d; font-family: 'Manrope Variable', system-ui, sans-serif; line-height: 1.55; }
      main { max-width: 860px; margin-inline: auto; padding: 48px clamp(16px, 4vw, 40px) 80px; }
      h1 { font-size: clamp(2rem, 5vw, 3rem); letter-spacing: -0.03em; margin: 0 0 12px; }
      .lead { color: #4a4f5c; max-width: 60ch; margin: 0 0 32px; }
      ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
      li { display: grid; grid-template-columns: 120px minmax(0, 1fr); gap: 16px; align-items: center; background: #fff; border-radius: 12px; padding: 10px; }
      img { width: 120px; height: 80px; object-fit: cover; border-radius: 8px; }
      li a { font-weight: 600; overflow-wrap: anywhere; }
      li p { margin: 2px 0 0; color: #5b6070; font-size: 0.95rem; }
    </style>
  </body>
</html>
